    (dict "file" "docs/MIGRATING-FROM-VEXVIPER.md" "path" "how-to-migrate-from-vexviper" "title" "How to: Migrate from VEXViper's client" "weight" 11)
    (dict "file" "docs/TESTING.md" "path" "testing" "title" "Testing" "weight" 20 "description" "Unit tests, the bomhorttest fake gateway and API drift detection.")
    (dict "file" "docs/API-COVERAGE.md" "path" "api-coverage" "title" "API Coverage" "weight" 30)
    (dict "file" "docs/COMPATIBILITY.md" "path" "compatibility" "title" "Compatibility & Versioning" "weight" 31)
  )
) }}
